# ============================================
# AutoTrade - Git Ignore Rules
# ============================================

# 🔐 环境配置 (敏感信息，绝不入库)
.env
.env.local
.env.*.local
backend/.env

# 🐍 Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
ENV/

# 📦 Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 🏗️ Build outputs
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# 🐳 Docker volumes & logs
*.log
*.log.*
logs/

# 🧪 Test & Coverage
.coverage
htmlcov/
.pytest_cache/
coverage/

# 📊 IDE & Editor
.idea/
.vscode/
*.swp
*.swo
*~

# 📁 OS Files
.DS_Store
Thumbs.db
desktop.ini

# 🗃️ Database
*.sql
*.dump
dump.rdb
backend/alembic/

# 🔒 Keys & Certificates
*.pem
*.key
*.crt
*.p12

# 📦 Archives & backups
*.zip
*.tar.gz
*.rar
*.7z
latest_code/

# 🧪 Test files (backend root)
backend/test_*.py
backend/debug_*.py
backend/check_*.py
backend/cleanup_*.py
backend/error.txt
backend/test_output.txt
backend/test_result.txt
backend/*.txt
!backend/requirements.txt

# .htpasswd (has passwords)
.htpasswd

# 📂 External reference files (not part of this project)
_reference/
